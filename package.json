{
  "name": "dsh-octo-channel",
  "description": "Production-grade Octo IM channel for DeepSeek Harness with bounded access policy, real connection readiness, reconnect recovery, and drainable replies",
  "version": "0.3.0",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && node scripts/integration-test.mjs && node scripts/regression-test.mjs && node scripts/crypto-test.mjs",
    "check": "npm test && git diff --check",
    "prepack": "npm run build"
  },
  "keywords": ["dsh", "deepseek-harness", "octo", "wukongim", "im", "channel", "plugin"],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.9.3"
  }
}
